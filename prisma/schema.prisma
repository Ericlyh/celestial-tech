generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "linux-arm64-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id          String   @id @default(cuid())
  title       String
  titleZh     String?  // Chinese (Traditional) title — falls back to title if null
  slug        String   @unique
  excerpt     String
  excerptZh   String?  // Chinese excerpt — falls back to excerpt if null
  content     String   // markdown body (English source of truth)
  contentZh   String?  // Chinese markdown body — falls back to content if null
  category    String   // "AI" | "Cybersecurity"
  coverImage  String?
  author      String   @default("Celestial Tech Team")
  authorZh    String?  // Chinese author label
  readTime    Int      @default(5)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sourceUrl   String?  // original news article source
  sourceName  String?  // e.g. "NewsAPI", "X", "YouTube"
}

model Meta {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
