# Database (SQLite - automatic with Prisma)
DATABASE_URL="file:./dev.db"

# NewsAPI (free tier: https://newsapi.org/register)
NEWS_API_KEY=

# Groq (free tier: https://console.groq.com/keys)
GROQ_API_KEY=

# Cron job security secret (generate with: openssl rand -hex 32)
CRON_SECRET=

# Optional: OpenAI (fallback if Groq not available)
OPENAI_API_KEY=

# ── Contact form (Resend + Cloudflare Turnstile) ────────────────────
# Get a Resend key at https://resend.com/api-keys
# `MAIL_FROM` must be a verified domain on Resend (or use the default sandbox sender).
# `MAIL_TO` is the inbox that receives contact submissions.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_TO=lyheric127@gmail.com

# Cloudflare Turnstile (https://www.cloudflare.com/products/turnstile/)
# The site key is exposed to the browser; the secret key is server-only.
# The values 1x000... are Cloudflare's documented always-pass test keys for local/dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
